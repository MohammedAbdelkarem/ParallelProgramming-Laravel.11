APP_NAME=Laravel_Template
APP_ENV=local
APP_KEY=base64:LYEOzWS1tGO2Cj+4Z0FFRMHY+n973bBXLbhi8PwcUmA=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_11_template_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=

# ─── هيئة النقل (منصة ربط / لوجستي) ────────────────────────────────────────
# Testing  → ضع RABET_WASL_URL و RABET_BAYAN_URL من منصة لوجستي (logisti.sa)
# Live     → بعد اعتماد الهيئة، نفس المفاتيح مع عناوين منصة ربط (rabet.sa)
RABET_ENVIRONMENT=logisti
RABET_STRICT_VEHICLE_CAPACITY=false
# true في الإنتاج: رفض العرض إذا فشل استعلام بيان أو لا توجد لوحة/ملكية مركبة عند وجوب فحص الحمولة
RABET_APP_ID=
RABET_APP_KEY=
RABET_CLIENT_ID=
# اختياري: مفاتيح بيان Elm فقط (إن اختلفت عن RABET_APP_* أعلاه)
# RABET_BAYAN_APP_ID=
# RABET_BAYAN_APP_KEY=
# RABET_BAYAN_CLIENT_ID=
RABET_WASL_URL=
RABET_BAYAN_URL=
# أصل بوابة لوجستي لـ manifest القديم فقط (مسارات bayan/...). إن كان RABET_BAYAN_URL=Elm (elm.sa) فهذا السطر ضروري وإلا ستحصل على 404 No Mapping Rule.
# RABET_BAYAN_LEGACY_URL=
# مهلة HTTP (ثواني) — openapi-definition / شبكات بطيئة
RABET_HTTP_TIMEOUT=45
# true = Wasl حسب openapi-definition.json (مسارات /eff/v1/...) | false = مسارات /carrier/ القديمة
RABET_WASL_USE_EFF=false
# مطلوب لـ EFF إذا ما عندك هجري في DB: YYYY-MM-DD (اختياري؛ بدونها يُستخدم نفس الميلادي كحل مؤقت)
# RABET_DRIVER_HIJRI_DOB=
# مسارات بيان “manifest” عبر البوابة (افتراضي bayan → /bayan/manifest). good-types: bayan-api.json
RABET_BAYAN_MANIFEST_PREFIX=bayan
RABET_BAYAN_VEHICLE_PATH_TEMPLATE="bayan/vehicle/%s"
# Elm Bayan (Postman): true = POST /api/v1/freight-forwarder/trip عند إنشاء رحلة CargoX | false = manifest القديم
RABET_BAYAN_USE_FREIGHT_FORWARDER=false
# RABET_BAYAN_FF_BASE_PATH=api/v1/freight-forwarder
# RABET_FF_CARRIER_MOI=7000000000
# RABET_FF_CARRIER_TYPE=COMPANY
# RABET_FF_GOOD_TYPE_ID=55
# RABET_FF_GOOD_TYPE_FROM_LOOKUP=true
# When true: goodTypeId = RABET_FF_GOOD_TYPE_ID if listed in GET good-types, else first id in list.
# RABET_FF_OVERRIDE_DRIVER_IDENTITY_FOR_TEST=
# Staging: valid 10-digit national/iqama (checksum) replaces driver DB id for Bayan FF only.
# RABET_FF_DEFAULT_DRIVER_IDENTITY_TYPE=1
# RABET_FF_DRIVER_IDENTITY_TYPE=
# RABET_FF_EXPECTED_DELIVERY_OFFSET_DAYS=1
# RABET_FF_DEFAULT_SHIPPER_NAME="شركة الأسيوطي عامر لتوريد البضائع"
# RABET_FF_DEFAULT_RECIPIENT_NAME="مؤسسة الاستلام التجارية"
# RABET_FF_ADDRESS_SENDER_FALLBACK="الرياض - حي السلي"
# RABET_FF_ADDRESS_RECIPIENT_FALLBACK="جدة - حي الميناء"
# RABET_FF_RECEIVING_LOCATION_ADDRESS="مستودع الرياض"
# RABET_FF_DELIVERY_LOCATION_ADDRESS="مستودع جدة"
# RABET_FF_ITEM_QUANTITY=10
# RABET_FF_CANCEL_WAYBILL_REASON_ID=1
# RABET_FF_ACTUAL_DELIVERY_TIMEZONE=Asia/Riyadh
# true = إغلاق البوليصة بتاريخ expectedDeliveryDate من GET الرحلة (Elm staging) | false = تقييد "اليوم" بين received و expected
# RABET_FF_CLOSE_USE_EXPECTED_DELIVERY_DATE=true
# Elm PUT waybill/close — يُقصّ تاريخ التسليم الفعلي بين receivedDate و expectedDate من GET الرحلة
# الأجرة total_price في الطلب يجب أن تساوي تقريباً price×quantity وإلا validItemPriceOrFare=false (لا تكرر عينة JSON فيها fare=350 وprice×qty=50000)
# RABET_FF_SENDER_CITY_ID=1
# RABET_FF_RECIPIENT_CITY_ID=2
# RABET_FF_PLATE_RIGHT_LETTER=أ
# RABET_FF_PLATE_MIDDLE_LETTER=ص
# RABET_FF_PLATE_LEFT_LETTER=م
ZOHO_BOOKS_SYNC_ENABLED=false
